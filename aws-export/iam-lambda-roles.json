{
    "RoleName":  "AI-Cloud-Maturity-Recommendation-Lambda-Role",
    "AssumeRolePolicyDocument":  {
                                     "Version":  "2012-10-17",
                                     "Statement":  [
                                                       {
                                                           "Effect":  "Allow",
                                                           "Principal":  {
                                                                             "Service":  "lambda.amazonaws.com"
                                                                         },
                                                           "Action":  "sts:AssumeRole"
                                                       }
                                                   ]
                                 },
    "AttachedPolicies":  [
                             {
                                 "Name":  "AWSLambdaBasicExecutionRole",
                                 "Arn":  "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
                                 "Document":  {
                                                  "Version":  "2012-10-17",
                                                  "Statement":  [
                                                                    {
                                                                        "Effect":  "Allow",
                                                                        "Action":  [
                                                                                       "logs:CreateLogGroup",
                                                                                       "logs:CreateLogStream",
                                                                                       "logs:PutLogEvents"
                                                                                   ],
                                                                        "Resource":  "*"
                                                                    }
                                                                ]
                                              }
                             }
                         ],
    "InlinePolicies":  [
                           {
                               "Name":  "AI-Cloud-Maturity-Bedrock-Converse",
                               "Document":  {
                                                "Version":  "2012-10-17",
                                                "Statement":  [
                                                                  {
                                                                      "Sid":  "AllowNovaMicroAPACInference",
                                                                      "Effect":  "Allow",
                                                                      "Action":  "bedrock:InvokeModel",
                                                                      "Resource":  [
                                                                                       "arn:aws:bedrock:ap-south-1:219712359023:inference-profile/apac.amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-south-1::foundation-model/amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-southeast-2::foundation-model/amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-northeast-1::foundation-model/amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-northeast-2::foundation-model/amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-southeast-1::foundation-model/amazon.nova-micro-v1:0",
                                                                                       "arn:aws:bedrock:ap-northeast-3::foundation-model/amazon.nova-micro-v1:0"
                                                                                   ]
                                                                  },
                                                                  {
                                                                      "Sid":  "AllowAssessmentWrite",
                                                                      "Effect":  "Allow",
                                                                      "Action":  "dynamodb:PutItem",
                                                                      "Resource":  "arn:aws:dynamodb:ap-south-1:219712359023:table/Assessments"
                                                                  }
                                                              ]
                                            }
                           },
                           {
                               "Name":  "CheckBedrockModelAvailability",
                               "Document":  {
                                                "Version":  "2012-10-17",
                                                "Statement":  [
                                                                  {
                                                                      "Sid":  "CheckNovaMicroAvailability",
                                                                      "Effect":  "Allow",
                                                                      "Action":  "bedrock:GetFoundationModelAvailability",
                                                                      "Resource":  "arn:aws:bedrock:ap-south-1::foundation-model/amazon.nova-micro-v1:0"
                                                                  }
                                                              ]
                                            }
                           }
                       ]
}
